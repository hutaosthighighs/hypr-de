{
  "layer": "bottom",
  "position": "left",

  "modules-left": [
    "group/power",
    "cpu",
    "memory"
  ],
  
  "modules-center": [
    "hyprland/workspaces"
  ],

  "modules-right": [
    "pulseaudio",
    "tray",
    "bluetooth",
    "battery",
    "clock"
  ],


  
  "cpu": {
    "format": " {}%",
    "interval": 5,
    "tooltip": false,
    "rotate" : 270
  },

  "memory": {
    "format": " {used:0.1f}GB",
    "interval": 5,
    "tooltip": false,
    "rotate" : 270
  },



  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "tooltip": false,
    "format" : ""
  },

  "pulseaudio": {
    "scroll-step": 2,
    "max-volume": 100,
    "format": "{icon}\n{volume}",
    "format-icons": [
      "",
      "",
      ""
    ],
    "nospacing": 1,
    "format-muted": "",
    "on-double-click": "pavucontrol",
    "tooltip": false
  },


  "tray": {
    "spacing": 10,
    "tooltip": false,
    "rotate" : 270
  },

  "clock": {
    "format": "{:%H\n%M}",
    "tooltip": false
  },
  "battery":{
    "format": "{icon}\n{capacity}",
    "tooltip": "{timeTo}",
    "format-icons":[
	    "",
	    "",
	    "",
	    "",
	    ""
    ]
  },
  "bluetooth":{
    "format-connected": "\n{device_battery_percentage}",
    "format-on": "",
    "tooltip": false,
    "on-click":"bluetooth"
  },
  "group/power":{
    "orientation":"inherit",
    "tooltip":false,
    "drawer":{
      "click-to-reveal": false,
      "children-class": "power-child",
      "transition-duration":250,
      "transition-left-to-right":true
    },
    "modules":[
      "custom/shutdown",
      "custom/lock",
      "custom/sleep"
    ]
  },
  "custom/lock":{
    "format":"",
    "tooltip": false,
    "on-click": "hyprlock"
  },
  "custom/shutdown":{
    "format":"",
    "tooltip":false,
    "on-click":"poweroff"
  },
  "custom/sleep":{
    "format":"",
    "tooltip":false,
    "on-click": "systemctl suspend"
  }

}
