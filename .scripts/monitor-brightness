#!/usr/bin/env bash

# Adjust external monitor brightness via DDC/CI

STEP=$1

CURRENT_BRIGHTNESS=$(ddcutil --bus=1 getvcp 10 | awk -F 'current value = ' 'NF>1 {split($2,a,","); print a[1]}')

if [[ -z $CURRENT_BRIGHTNESS ]]; then
  echo "could not read brightness"
  exit 1
fi

if [[ -z $STEP ]]; then
  echo $CURRENT_BRIGHTNESS
  exit 1
fi

if [[ "$STEP" =~ ^[\+\-] ]]; then
    NEW_BRIGHTNESS=$((CURRENT_BRIGHTNESS + STEP))
else
    NEW_BRIGHTNESS=$STEP
fi


# Clamp between 10 and 100
if [[ $NEW_BRIGHTNESS -gt 100 ]]; then NEW_BRIGHTNESS=100; fi
if [[ $NEW_BRIGHTNESS -lt 0 ]]; then NEW_BRIGHTNESS=0; fi # Limit it to 10 (as to not make screen completely black)

ddcutil --bus=1 setvcp 10 $NEW_BRIGHTNESS